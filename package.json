{
  "name": "awale-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "npm run test:engine && npm run test:preview && npm run test:layout && npm run test:navigation && npm run test:ai && npm run test:stats && npm run test:native && npm run test:online && npm run test:auth && npm run test:qr && npm run test:selfplay",
    "test:engine": "node --experimental-strip-types --no-warnings test/engine.test.ts",
    "test:preview": "node --experimental-strip-types --no-warnings test/preview.test.ts",
    "test:layout": "node --experimental-strip-types --no-warnings test/layout.test.ts",
    "test:navigation": "node --experimental-strip-types --no-warnings test/navigation.test.ts",
    "test:ai": "node --experimental-strip-types --no-warnings test/ai.test.ts",
    "test:stats": "node --experimental-strip-types --no-warnings test/stats.test.ts",
    "test:native": "node --experimental-strip-types --no-warnings test/native.test.ts",
    "test:online": "node --experimental-strip-types --no-warnings test/online.test.ts",
    "test:auth": "node --experimental-strip-types --no-warnings test/auth.test.ts",
    "test:qr": "node --experimental-strip-types --no-warnings test/qr.test.ts",
    "test:selfplay": "node --experimental-strip-types --no-warnings test/selfplay.test.ts",
    "test:e2e": "playwright test",
    "dev:server": "node --experimental-strip-types --no-warnings server/dev-server.ts",
    "verify:challenges": "node --experimental-strip-types --no-warnings scripts/verify-challenges.ts",
    "sounds:generate": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings scripts/gen-sounds.ts"
  },
  "dependencies": {
    "@capacitor-community/in-app-review": "^8.0.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsqr": "^1.4.0",
    "playwright": "^1.61.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^5.4.11",
    "ws": "^8.18.0"
  }
}
