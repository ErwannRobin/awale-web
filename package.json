{
  "name": "awale-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "npm run test:engine && npm run test:layout && npm run test:ai && npm run test:stats && npm run test:selfplay",
    "test:engine": "node --experimental-strip-types --no-warnings test/engine.test.ts",
    "test:layout": "node --experimental-strip-types --no-warnings test/layout.test.ts",
    "test:ai": "node --experimental-strip-types --no-warnings test/ai.test.ts",
    "test:stats": "node --experimental-strip-types --no-warnings test/stats.test.ts",
    "test:selfplay": "node --experimental-strip-types --no-warnings test/selfplay.test.ts",
    "test:e2e": "playwright test",
    "verify:challenges": "node --experimental-strip-types --no-warnings scripts/verify-challenges.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "playwright": "^1.61.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^5.4.11"
  }
}
